<?xml version="1.0"?>
<package format="3">
  <name>lio_web</name>
  <version>0.1.0</version>
  <description>Low-bandwidth ROS 2 point-cloud WebSocket viewer for IteraLIO.</description>
  <maintainer email="rainbroken135@gmail.com">rainbroken</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>pybind11-dev</build_depend>
  <build_depend>python3-dev</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-aiohttp</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
